# Security & Authentication (Required for Tunnel & Public Access)
API_KEY=your_secure_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# CoinDCX API (Required for live trading)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# Binance API (Fallback exchange)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Ollama LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_MODEL=mistral

# Trading Mode
PAPER_MODE=true
PAPER_BALANCE=10000

# Server (Default binds to 127.0.0.1 for security)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Risk Defaults
MAX_POSITION_PCT=5
MAX_OPEN_TRADES=5
DAILY_LOSS_LIMIT_PCT=3
DEFAULT_STOP_LOSS_PCT=1.5
DEFAULT_TAKE_PROFIT_PCT=3.0
TRAILING_STOP_ACTIVATE_PCT=1.5
TRAILING_STOP_TRAIL_PCT=0.5

# Alerting & Notifications (Agent 5)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
ALERTS_ENABLED=true
